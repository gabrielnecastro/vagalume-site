# Copy this file to ".env" to override the defaults (optional — the defaults already work).
# docker compose reads it automatically; the app reads DATABASE_URL from the environment.

POSTGRES_USER=vagalume
POSTGRES_PASSWORD=vagalume
POSTGRES_DB=vagalume
# change if port 5432 is already taken by another Postgres on your machine
POSTGRES_PORT=5432

# Connection string used by the app
DATABASE_URL=postgres://vagalume:vagalume@localhost:5432/vagalume
